# Production (Neon example) or local Postgres
# Neon: use the pooled URL and keep sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Force TLS for cloud DBs that omit sslmode in the URL
# DATABASE_SSL=true

# Optional: SpaceXAI / xAI key for "Help me pick better"
XAI_API_KEY=

# Bookmaker country path (ng, gh, tz, zm, ke, ...)
SPORTY_COUNTRY=ng

# Preferred brand for share codes: sportybet | football
DEFAULT_BOOKMAKER=football
